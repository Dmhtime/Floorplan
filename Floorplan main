            tbody.innerHTML = '';
            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                const lenM = Math.hypot(verts[j].x - verts[i].x, verts[j].z - verts[i].z);
                const ops = state.openings.filter(o => o.wallIndex === i);
                const opDesc = ops.length === 0 ? 'Solid Wall' : ops.map(o => o.type === 'door' ? '1 Door' : '1 Window').join(', ');

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="py-3 px-4 font-extrabold text-blue-700">Wall #${i + 1}</td>
