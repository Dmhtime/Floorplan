            document.getElementById('printSqFt').textContent = `${sqFt} sq ft`;
            document.getElementById('printSqFtPlusWaste').textContent = `+10% flooring waste: ${Math.ceil(sqFt * 1.1)} sq ft`;
            document.getElementById('printPerimeter').textContent = formatFeetInchesLong(periMeters);
            document.getElementById('printWallCount').textContent = `${verts.length} Walls`;
            document.getElementById('printOpenings').textContent = `${doors} Doors, ${wins} Windows`;

            // Draw clean non-interactive snapshot onto print canvas
