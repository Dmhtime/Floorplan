        }

        function openScanHelpModal() {
            document.getElementById('scanHelpModal').classList.remove('hidden');
        }
        function closeScanHelpModal() {
            document.getElementById('scanHelpModal').classList.add('hidden');
        }

        function animateLoop() {
            requestAnimationFrame(animateLoop);
            if (state.step === 2 && renderer3D && scene3D && camera3D) {
                renderer3D.render(scene3D, camera3D);
            }
        }

        window.addEventListener('resize', () => {
            if (state.step === 2) {
                resize2DCanvas();
                resizeThreeViewport();
            }
        });

        window.onload = function () {
            // Preload default room so Step 2 or Step 3 works immediately even if clicked directly
            state.vertices = JSON.parse(JSON.stringify(EASY_PRESETS.living.vertices));
            state.openings = JSON.parse(JSON.stringify(EASY_PRESETS.living.openings));
            init3DDollhouse();
            animateLoop();
        };
    </script>
