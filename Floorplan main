        function downloadContractorDXF() {
            const verts = state.vertices;
            let dxf = `0\nSECTION\n2\nENTITIES\n`;
            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                dxf += `0\nLINE\n8\nWALLS\n10\n${verts[i].x.toFixed(4)}\n20\n${(-verts[i].z).toFixed(4)}\n30\n0.0\n11\n${verts[j].x.toFixed(4)}\n21\n${(-verts[j].z).toFixed(4)}\n31\n0.0\n`;
            }
            dxf += `0\nENDSEC\n0\nEOF\n`;
            const blob = new Blob([dxf], { type: 'application/dxf' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${state.roomName.replace(/\s+/g, '_')}_Contractor.dxf`;
            a.click();
            URL.revokeObjectURL(url);
