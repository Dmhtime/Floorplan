        async function openCameraMeasureModal() {
            document.getElementById('cameraMeasureModal').classList.remove('hidden');
            state.cameraMeasurer.points = [];
            updateEasyCameraAim();

            try {
                if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                    const perm = await DeviceOrientationEvent.requestPermission();
                    if (perm === 'granted') {
                        window.addEventListener('deviceorientation', onEasyDeviceOrientation);
                    }
                } else {
                    window.addEventListener('deviceorientation', onEasyDeviceOrientation);
                }

                if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
                    document.getElementById('easyCameraVideo').srcObject = stream;
                }
            } catch (e) {
                // Works seamlessly in simulated mode if camera is declined or on desktop
            }
        }

