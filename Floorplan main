        function drawMiniCornerPreview() {
            const c = document.getElementById('miniCornerPreviewCanvas');
            if (!c) return;
            const ctx = c.getContext('2d');
            ctx.clearRect(0, 0, c.width, c.height);
            const cx = c.width / 2;
            const cy = c.height / 2;
            const scale = 16;

            const pts = state.cameraMeasurer.points;
            if (pts.length > 0) {
                ctx.strokeStyle = '#38bdf8';
                ctx.fillStyle = 'rgba(56, 189, 248, 0.2)';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                pts.forEach((p, i) => {
                    if (i === 0) ctx.moveTo(cx + p.x * scale, cy + p.z * scale);
                    else ctx.lineTo(cx + p.x * scale, cy + p.z * scale);
                });
                if (pts.length > 2) ctx.closePath();
                ctx.fill();
                ctx.stroke();

                pts.forEach(p => {
                    ctx.fillStyle = '#10b981';
                    ctx.beginPath();
                    ctx.arc(cx + p.x * scale, cy + p.z * scale, 4, 0, Math.PI * 2);
                    ctx.fill();
                });
            }

            const hit = state.cameraMeasurer.currentHit;
            ctx.strokeStyle = '#10b981';
            ctx.setLineDash([3, 3]);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(cx + hit.x * scale, cy + hit.z * scale);
            ctx.stroke();
            ctx.setLineDash([]);
        }

        function renderPrintableContractorSheet() {
