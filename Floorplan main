                ceilingHeight: 2.44, // 8 ft 0 in
                vertices: [
                    { x: -2.74, z: -2.13 }, // 18ft x 14ft rectangle
                    { x: 2.74, z: -2.13 },
                    { x: 2.74, z: 2.13 },
                    { x: -2.74, z: 2.13 }
                ],
                openings: [
                    { type: 'door', wallIndex: 0, t: 0.25, width: 0.91 },
                    { type: 'window', wallIndex: 1, t: 0.50, width: 1.52 },
                    { type: 'window', wallIndex: 2, t: 0.50, width: 1.83 }
                ]
            },
            kitchen: {
                name: "Kitchen & Dining Area",
                ceilingHeight: 2.74,
                vertices: [
                    { x: -3.35, z: -2.44 },
                    { x: 3.35, z: -2.44 },
                    { x: 3.35, z: 2.44 },
                    { x: -1.22, z: 2.44 },
                    { x: -1.22, z: 1.22 },
                    { x: -3.35, z: 1.22 }
                ],
                openings: [
                    { type: 'door', wallIndex: 0, t: 0.20, width: 0.91 },
                    { type: 'window', wallIndex: 1, t: 0.50, width: 1.60 },
                    { type: 'door', wallIndex: 2, t: 0.70, width: 1.52 }
                ]
            }
        };

        let state = {
            step: 1,
            roomName: "Family Living Room",
            ceilingHeight: 2.74,
            vertices: [],
            openings: [],
            history: [],
            tool: 'move', // 'move' | 'door' | 'window' | 'split'
            selectedWallIndex: 0,
            draggingVertexIndex: -1,
            hoveredVertexIndex: -1,
            cam2D: {
                offsetX: 0,
                offsetY: 0,
                scale: 46,
                isPanning: false,
                panStartX: 0,
                panStartY: 0
            },
            cameraMeasurer: {
                yaw: 40,
                pitch: 28,
                heightMeters: 1.37, // 4.5 ft
                points: [],
                currentHit: { x: 1.6, z: -2.0, distMeters: 2.56 }
            }
        };

        function saveStateForUndo() {
            state.history.push({
                vertices: JSON.parse(JSON.stringify(state.vertices)),
                openings: JSON.parse(JSON.stringify(state.openings))
            });
            if (state.history.length > 25) state.history.shift();
        }

        function undoLastChange() {
            if (state.history.length === 0) {
                showFriendlyToast("Nothing more to undo!");
                return;
            }
            const prev = state.history.pop();
            state.vertices = prev.vertices;
            state.openings = prev.openings;
            state.selectedWallIndex = 0;
            refreshEverything();
            showFriendlyToast("Undid last change");
        }

        function metersToFeetInchesObj(meters) {
            const totalInches = Math.round(meters * 39.3700787);
            const feet = Math.floor(totalInches / 12);
            const inches = totalInches % 12;
            return { feet, inches };
        }

        function formatFeetInches(meters) {
            const { feet, inches } = metersToFeetInchesObj(meters);
            return `${feet}' ${inches}"`;
        }

        function formatFeetInchesLong(meters) {
            const { feet, inches } = metersToFeetInchesObj(meters);
            return `${feet} ft ${inches} in`;
        }

        function computeAreaSqMeters(verts) {
            if (verts.length < 3) return 0;
            let area = 0;
            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                area += verts[i].x * verts[j].z - verts[j].x * verts[i].z;
            }
            return Math.abs(area) / 2;
        }

        function computePerimeterMeters(verts) {
            if (verts.length < 2) return 0;
            let sum = 0;
            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                sum += Math.hypot(verts[j].x - verts[i].x, verts[j].z - verts[i].z);
            }
            return sum;
        }

        function showFriendlyToast(message) {
            const el = document.getElementById('friendlyToast');
            const txt = document.getElementById('friendlyToastText');
            txt.textContent = message;
            el.classList.remove('hidden');
            clearTimeout(window._toastTimer);
            window._toastTimer = setTimeout(() => {
                el.classList.add('hidden');
            }, 3400);
        }

        function goToStep(stepNumber) {
            state.step = stepNumber;
            [1, 2, 3].forEach(n => {
                const sec = document.getElementById(`step${n}Section`);
                const tab = document.getElementById(`wizardTab${n}`);
                if (n === stepNumber) {
                    sec.classList.remove('hidden');
                    tab.className = "touch-btn px-3 sm:px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-blue-600 text-white shadow";
                } else {
                    sec.classList.add('hidden');
                    tab.className = "touch-btn px-3 sm:px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 text-slate-600 hover:bg-white";
                }
            });

            if (stepNumber === 2) {
                setTimeout(() => {
                    resize2DCanvas();
                    resizeThreeViewport();
                    refreshEverything();
                }, 50);
            } else if (stepNumber === 3) {
                setTimeout(() => {
                    renderPrintableContractorSheet();
                }, 50);
            }
        }

        function loadPresetAndGo(key) {
            const preset = EASY_PRESETS[key];
            if (!preset) return;
            state.roomName = preset.name;
            state.ceilingHeight = preset.ceilingHeight;
            state.vertices = JSON.parse(JSON.stringify(preset.vertices));
            state.openings = JSON.parse(JSON.stringify(preset.openings));
            state.history = [];
            state.selectedWallIndex = 0;
            document.getElementById('roomNameInput').value = state.roomName;
            goToStep(2);
            selectWall(0);
            showFriendlyToast(`Loaded "${preset.name}" — Drag any blue corner to adjust!`);
        }

        function updateRoomName(val) {
            state.roomName = val || "My Room Floorplan";
        }

        const canvas2D = document.getElementById('canvas2D');
        const ctx2D = canvas2D.getContext('2d');

        function worldToScreen(wx, wz) {
            return {
                x: canvas2D.width / 2 + state.cam2D.offsetX + wx * state.cam2D.scale,
                y: canvas2D.height / 2 + state.cam2D.offsetY + wz * state.cam2D.scale
            };
        }

        function screenToWorld(sx, sy) {
            return {
                x: (sx - canvas2D.width / 2 - state.cam2D.offsetX) / state.cam2D.scale,
                z: (sy - canvas2D.height / 2 - state.cam2D.offsetY) / state.cam2D.scale
            };
        }

        function resize2DCanvas() {
            const parent = canvas2D.parentElement;
            if (!parent) return;
            const rect = parent.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
                canvas2D.width = rect.width;
                canvas2D.height = rect.height;
                drawFloorplanOnCanvas(ctx2D, canvas2D.width, canvas2D.height, state.cam2D.scale, state.cam2D.offsetX, state.cam2D.offsetY, true);
            }
        }

        function drawFloorplanOnCanvas(ctx, width, height, scale, offsetX, offsetY, isInteractive) {
            ctx.clearRect(0, 0, width, height);
            const verts = state.vertices;
            if (verts.length < 3) return;

            const toScreen = (wx, wz) => ({
                x: width / 2 + offsetX + wx * scale,
                y: height / 2 + offsetY + wz * scale
            });

            // 1. Soft Light Blue Room Fill
            ctx.beginPath();
            verts.forEach((v, i) => {
                const p = toScreen(v.x, v.z);
                if (i === 0) ctx.moveTo(p.x, p.y);
                else ctx.lineTo(p.x, p.y);
            });
            ctx.closePath();
            ctx.fillStyle = 'rgba(37, 99, 235, 0.08)';
            ctx.fill();

            // 2. Room Center Label (Name + Total Sq Ft)
            let cx = 0, cz = 0;
            verts.forEach(v => { cx += v.x; cz += v.z; });
            cx /= verts.length;
            cz /= verts.length;
            const centerScreen = toScreen(cx, cz);
            const sqFt = Math.round(computeAreaSqMeters(verts) * 10.7639);

            ctx.fillStyle = 'rgba(15, 23, 42, 0.45)';
            ctx.font = '800 16px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(state.roomName, centerScreen.x, centerScreen.y - 8);
            ctx.font = '700 14px Inter, sans-serif';
            ctx.fillText(`${sqFt} sq ft`, centerScreen.x, centerScreen.y + 14);

            // 3. Draw Thick High-Contrast Walls & Openings
            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                const p1 = toScreen(verts[i].x, verts[i].z);
                const p2 = toScreen(verts[j].x, verts[j].z);
                const isSelected = isInteractive && (i === state.selectedWallIndex);

                ctx.strokeStyle = isSelected ? '#2563eb' : '#0f172a';
                ctx.lineWidth = isSelected ? 10 : 8;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.stroke();

                // Draw Doors & Windows on Wall
                const wallOpenings = state.openings.filter(o => o.wallIndex === i);
                const segPx = Math.hypot(p2.x - p1.x, p2.y - p1.y);
                if (segPx > 10) {
                    const ux = (p2.x - p1.x) / segPx;
                    const uy = (p2.y - p1.y) / segPx;
                    const nx = -uy;
                    const ny = ux;

                    wallOpenings.forEach(op => {
                        const ox = p1.x + (p2.x - p1.x) * op.t;
                        const oy = p1.y + (p2.y - p1.y) * op.t;
                        const halfW = (op.width * scale) / 2;

                        // White knockout
                        ctx.strokeStyle = '#ffffff';
                        ctx.lineWidth = 12;
                        ctx.beginPath();
                        ctx.moveTo(ox - ux * halfW, oy - uy * halfW);
                        ctx.lineTo(ox + ux * halfW, oy + uy * halfW);
                        ctx.stroke();

                        if (op.type === 'window') {
                            ctx.strokeStyle = '#0284c7';
                            ctx.lineWidth = 5;
                            ctx.beginPath();
                            ctx.moveTo(ox - ux * halfW, oy - uy * halfW);
                            ctx.lineTo(ox + ux * halfW, oy + uy * halfW);
                            ctx.stroke();
                        } else {
                            // Door swing leaf
                            const hx = ox - ux * halfW;
                            const hy = oy - uy * halfW;
                            ctx.strokeStyle = '#d97706';
                            ctx.lineWidth = 3.5;
                            ctx.beginPath();
                            ctx.moveTo(hx, hy);
                            ctx.lineTo(hx + nx * halfW * 1.8, hy + ny * halfW * 1.8);
                            ctx.stroke();
                        }
                    });
                }

                // Draw Big High-Contrast Feet & Inches Badge on Wall Midpoint
                const midX = (p1.x + p2.x) / 2;
                const midY = (p1.y + p2.y) / 2;
                const lenMeters = Math.hypot(verts[j].x - verts[i].x, verts[j].z - verts[i].z);
                const label = `#${i + 1}: ${formatFeetInches(lenMeters)}`;

                ctx.font = '800 13px Inter, sans-serif';
                const badgeW = ctx.measureText(label).width + 18;
                const badgeH = 26;

                ctx.fillStyle = isSelected ? '#2563eb' : '#ffffff';
                ctx.strokeStyle = isSelected ? '#1d4ed8' : '#0f172a';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.roundRect(midX - badgeW / 2, midY - badgeH / 2, badgeW, badgeH, 8);
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = isSelected ? '#ffffff' : '#0f172a';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(label, midX, midY);
            }

            // 4. Draw Large Touch-Friendly Blue Corner Handles
            if (isInteractive) {
                verts.forEach((v, idx) => {
                    const p = toScreen(v.x, v.z);
                    const isActive = (idx === state.draggingVertexIndex || idx === state.hoveredVertexIndex);
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, isActive ? 14 : 11, 0, Math.PI * 2);
                    ctx.fillStyle = isActive ? '#10b981' : '#2563eb';
                    ctx.fill();
                    ctx.lineWidth = 3;
                    ctx.strokeStyle = '#ffffff';
                    ctx.stroke();
                });
            }
        }

        function getPointerCanvasXY(evt) {
            const rect = canvas2D.getBoundingClientRect();
            const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
            const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        function projectPointToWall(px, py, x1, y1, x2, y2) {
            const dx = x2 - x1;
            const dy = y2 - y1;
            const lenSq = dx * dx + dy * dy;
            if (lenSq === 0) return { t: 0.5, dist: Math.hypot(px - x1, py - y1), x: x1, y: y1 };
            let t = ((px - x1) * dx + (py - y1) * dy) / lenSq;
            t = Math.max(0.1, Math.min(0.9, t));
            const projX = x1 + t * dx;
            const projY = y1 + t * dy;
            return { t, dist: Math.hypot(px - projX, py - projY), x: projX, y: projY };
        }

        canvas2D.addEventListener('pointerdown', (evt) => {
            const pos = getPointerCanvasXY(evt);
            const verts = state.vertices;

            // 1. Check if grabbing a corner circle (generous 24px touch radius)
            for (let i = 0; i < verts.length; i++) {
                const sp = worldToScreen(verts[i].x, verts[i].z);
                if (Math.hypot(pos.x - sp.x, pos.y - sp.y) < 24) {
                    saveStateForUndo();
                    state.draggingVertexIndex = i;
                    return;
                }
            }

            // 2. Check if tapping a wall
            let hitWall = -1;
            let hitProj = null;
            let bestDist = 24;

            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                const p1 = worldToScreen(verts[i].x, verts[i].z);
                const p2 = worldToScreen(verts[j].x, verts[j].z);
                const proj = projectPointToWall(pos.x, pos.y, p1.x, p1.y, p2.x, p2.y);
                if (proj.dist < bestDist) {
                    bestDist = proj.dist;
                    hitWall = i;
                    hitProj = proj;
                }
            }

            if (hitWall !== -1) {
                selectWall(hitWall);

                if (state.tool === 'door' || state.tool === 'window') {
                    saveStateForUndo();
                    state.openings.push({
                        type: state.tool,
                        wallIndex: hitWall,
                        t: Number(hitProj.t.toFixed(2)),
                        width: state.tool === 'door' ? 0.91 : 1.52
                    });
                    setSimpleTool('move');
                    refreshEverything();
                    showFriendlyToast(`Added a ${state.tool === 'door' ? 'Door' : 'Window'} on Wall #${hitWall + 1}`);
                    return;
                }

                if (state.tool === 'split') {
                    saveStateForUndo();
                    const worldPt = screenToWorld(hitProj.x, hitProj.y);
                    state.vertices.splice(hitWall + 1, 0, {
                        x: Number(worldPt.x.toFixed(2)),
                        z: Number(worldPt.z.toFixed(2))
                    });
                    setSimpleTool('move');
                    refreshEverything();
                    showFriendlyToast("Added a new corner! Drag the blue circle to move it.");
                    return;
                }
                return;
            }

            // 3. Otherwise pan the canvas
            state.cam2D.isPanning = true;
            state.cam2D.panStartX = pos.x - state.cam2D.offsetX;
            state.cam2D.panStartY = pos.y - state.cam2D.offsetY;
        });

        canvas2D.addEventListener('pointermove', (evt) => {
            const pos = getPointerCanvasXY(evt);

            if (state.draggingVertexIndex !== -1) {
                const worldPt = screenToWorld(pos.x, pos.y);
                // Snap to ~1 inch (0.0254m)
                state.vertices[state.draggingVertexIndex] = {
                    x: Math.round(worldPt.x * 39.37) / 39.37,
                    z: Math.round(worldPt.z * 39.37) / 39.37
                };
                selectWall(state.selectedWallIndex);
                refreshEverything();
                return;
            }

            if (state.cam2D.isPanning) {
                state.cam2D.offsetX = pos.x - state.cam2D.panStartX;
                state.cam2D.offsetY = pos.y - state.cam2D.panStartY;
                resize2DCanvas();
            }
        });

        window.addEventListener('pointerup', () => {
            state.draggingVertexIndex = -1;
            state.cam2D.isPanning = false;
        });

        function zoom2D(factor) {
            state.cam2D.scale = Math.max(20, Math.min(110, state.cam2D.scale * factor));
            resize2DCanvas();
        }

        function center2DView() {
            state.cam2D.offsetX = 0;
            state.cam2D.offsetY = 0;
            state.cam2D.scale = 46;
            resize2DCanvas();
        }

        function setSimpleTool(toolName) {
            state.tool = toolName;
            const all = ['move', 'door', 'window', 'split'];
            all.forEach(t => {
                const btn = document.getElementById(`easyTool-${t}`);
                if (!btn) return;
                if (t === toolName) {
                    btn.className = "touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-blue-600 text-white shadow flex items-center gap-2";
                } else {
                    btn.className = "touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 flex items-center gap-2";
                }
            });

            const messages = {
                move: "Drag any blue circle with your finger to move a corner, or tap a wall to type its exact length.",
                door: "🚪 TAP ANY WALL on the floorplan below where you want to put a Door.",
                window: "🪟 TAP ANY WALL on the floorplan below where you want to put a Window.",
                split: "➕ TAP ANY WALL on the floorplan below to add a new movable corner."
            };
            document.getElementById('helperInstructionBanner').textContent = messages[toolName];
