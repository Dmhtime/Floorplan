```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Easy Room Floorplan Maker — Simple 3-Step iPad Guide</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        body {
            background-color: #f8fafc;
            color: #0f172a;
            overflow-x: hidden;
        }
        .touch-btn {
            min-height: 54px;
            transition: transform 0.12s ease, background-color 0.15s ease, box-shadow 0.15s ease;
        }
        .touch-btn:active {
            transform: scale(0.97);
        }
        .blueprint-grid {
            background-color: #ffffff;
            background-size: 32px 32px;
            background-image:
                linear-gradient(to right, rgba(37, 99, 235, 0.08) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(37, 99, 235, 0.08) 1px, transparent 1px);
        }
        @media print {
            body {
                background: #ffffff !important;
                overflow: visible !important;
            }
            .no-print {
                display: none !important;
            }
            #printSheetContainer {
                display: block !important;
                box-shadow: none !important;
                border: none !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-100 text-slate-900">

    <header class="no-print bg-white border-b-2 border-slate-200 px-4 py-3 shadow-sm sticky top-0 z-30">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
            <!-- Brand Title -->
            <div class="flex items-center justify-between w-full md:w-auto">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-md font-extrabold text-xl">
                        🏠
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">Easy Floorplan Maker</h1>
                        <p class="text-sm text-slate-600 font-medium">Measure your room in 3 simple steps</p>
                    </div>
                </div>
                <button onclick="openScanHelpModal()" class="md:hidden px-3.5 py-2.5 rounded-xl bg-amber-100 text-amber-900 font-bold text-sm border border-amber-300">
                    ❓ Help
                </button>
            </div>

            <!-- 3-Step Guided Wizard Buttons -->
            <nav class="grid grid-cols-3 gap-2 w-full md:w-auto bg-slate-100 p-1.5 rounded-2xl border border-slate-200">
                <button onclick="goToStep(1)" id="wizardTab1" class="touch-btn px-3 sm:px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 bg-blue-600 text-white shadow">
                    <span class="w-7 h-7 rounded-full bg-white text-blue-600 font-extrabold flex items-center justify-center text-sm shrink-0">1</span>
                    <span>Pick or Scan Room</span>
                </button>
                <button onclick="goToStep(2)" id="wizardTab2" class="touch-btn px-3 sm:px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 text-slate-600 hover:bg-white">
                    <span class="w-7 h-7 rounded-full bg-slate-300 text-slate-800 font-extrabold flex items-center justify-center text-sm shrink-0">2</span>
                    <span>View & Adjust</span>
                </button>
                <button onclick="goToStep(3)" id="wizardTab3" class="touch-btn px-3 sm:px-5 py-2.5 rounded-xl font-bold text-sm sm:text-base flex items-center justify-center gap-2 text-slate-600 hover:bg-white">
                    <span class="w-7 h-7 rounded-full bg-slate-300 text-slate-800 font-extrabold flex items-center justify-center text-sm shrink-0">3</span>
                    <span>Print & Save</span>
                </button>
            </nav>

            <!-- Easy Help Button -->
            <button onclick="openScanHelpModal()" class="hidden md:flex touch-btn px-4 py-2.5 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-base items-center gap-2 border-2 border-amber-300 shrink-0">
                <span>❓ How to Scan on iPad</span>
            </button>
        </div>
    </header>

    <!-- Friendly Reassuring Notification Banner -->
    <div id="friendlyToast" class="no-print hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-50 bg-emerald-700 text-white px-6 py-4 rounded-2xl shadow-2xl border-2 border-emerald-400 flex items-center gap-3 text-base sm:text-lg font-bold max-w-xl w-[92%] justify-center text-center">
        <span>✅</span>
        <span id="friendlyToastText">Your room is ready!</span>
    </div>

    <main class="flex-1 flex flex-col max-w-7xl w-full mx-auto p-4 sm:p-6">

        <!-- ==================== STEP 1: START / SCAN / PICK A ROOM ==================== -->
        <section id="step1Section" class="space-y-6 my-auto py-2">
            <div class="text-center max-w-2xl mx-auto space-y-2">
                <span class="inline-block px-4 py-1 rounded-full bg-blue-100 text-blue-800 font-bold text-sm uppercase tracking-wide">Step 1 of 3</span>
                <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900">How would you like to start?</h2>
                <p class="text-base sm:text-lg text-slate-600">Tap any of the big buttons below. You cannot break anything—you can always undo or start over!</p>
            </div>

            <!-- 3 Giant Choice Cards -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Option A: Load iPad Scan File -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-blue-500 shadow-lg flex flex-col justify-between space-y-6">
                    <div class="space-y-4">
                        <div class="w-16 h-16 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-4xl">
                            📂
                        </div>
                        <div class="inline-block px-3 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold text-xs uppercase">Most Accurate (Uses iPad LiDAR)</div>
                        <h3 class="text-2xl font-extrabold text-slate-900">1. Load My iPad Scan File</h3>
                        <p class="text-base text-slate-600 leading-relaxed">
                            Already scanned your room with the free <strong>3D Scanner App</strong> on your iPad? Tap below to pick your saved file and turn it into a floorplan automatically.
                        </p>
                    </div>

                    <div class="space-y-3 pt-2">
                        <input id="scanFileInput" type="file" accept=".json,.obj,.glb,.gltf,.usdz,.zip" class="hidden" onchange="handleEasyFileUpload(event)">
                        <button onclick="document.getElementById('scanFileInput').click()" class="touch-btn w-full py-4 px-6 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-lg shadow-lg shadow-blue-600/25 flex items-center justify-center gap-3">
                            <span>📂 Tap to Pick Scan File</span>
                        </button>
                        <button onclick="openScanHelpModal()" class="touch-btn w-full py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-base">
                            Show me how to scan on my iPad →
                        </button>
                    </div>
                </div>

                <!-- Option B: Point & Tap Camera Measurer -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-emerald-500 shadow-lg flex flex-col justify-between space-y-6">
                    <div class="space-y-4">
                        <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-4xl">
                            📷
                        </div>
                        <div class="inline-block px-3 py-1 rounded-lg bg-emerald-50 text-emerald-800 font-bold text-xs uppercase">No Other App Needed</div>
                        <h3 class="text-2xl font-extrabold text-slate-900">2. Measure with iPad Camera</h3>
                        <p class="text-base text-slate-600 leading-relaxed">
                            Stand in the middle of your room, point your iPad camera at each corner on the floor, and tap one big green button to connect the walls.
                        </p>
                    </div>

                    <div class="space-y-3 pt-2">
                        <button onclick="openCameraMeasureModal()" class="touch-btn w-full py-4 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-lg shadow-lg shadow-emerald-600/25 flex items-center justify-center gap-3">
                            <span>📷 Open Camera Measurer</span>
                        </button>
                        <p class="text-sm text-center text-slate-500 font-medium">Takes about 30 seconds right in this screen</p>
                    </div>
                </div>

                <!-- Option C: Try a Pre-Made Room Template -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-slate-300 shadow-lg flex flex-col justify-between space-y-6">
                    <div class="space-y-4">
                        <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-4xl">
                            📐
                        </div>
                        <div class="inline-block px-3 py-1 rounded-lg bg-amber-50 text-amber-800 font-bold text-xs uppercase">Great for Practice or Quick Edits</div>
                        <h3 class="text-2xl font-extrabold text-slate-900">3. Start with a Sample Room</h3>
                        <p class="text-base text-slate-600 leading-relaxed">
                            Pick a standard room shape below and simply drag the walls with your finger to match your room's measurements.
                        </p>
                    </div>

                    <div class="space-y-2.5 pt-2">
                        <button onclick="loadPresetAndGo('living')" class="touch-btn w-full py-3.5 px-4 rounded-xl bg-slate-100 hover:bg-blue-50 hover:border-blue-400 border-2 border-slate-200 font-bold text-base text-slate-800 flex items-center justify-between">
                            <span>🛋️ Living Room (L-Shaped)</span>
                            <span class="text-blue-600 font-extrabold">Open →</span>
                        </button>
                        <button onclick="loadPresetAndGo('bedroom')" class="touch-btn w-full py-3.5 px-4 rounded-xl bg-slate-100 hover:bg-blue-50 hover:border-blue-400 border-2 border-slate-200 font-bold text-base text-slate-800 flex items-center justify-between">
                            <span>🛏️ Master Bedroom (Rectangle)</span>
                            <span class="text-blue-600 font-extrabold">Open →</span>
                        </button>
                        <button onclick="loadPresetAndGo('kitchen')" class="touch-btn w-full py-3.5 px-4 rounded-xl bg-slate-100 hover:bg-blue-50 hover:border-blue-400 border-2 border-slate-200 font-bold text-base text-slate-800 flex items-center justify-between">
                            <span>🍳 Kitchen & Dining Area</span>
                            <span class="text-blue-600 font-extrabold">Open →</span>
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== STEP 2: VIEW & ADJUST MY FLOORPLAN ==================== -->
        <section id="step2Section" class="hidden flex-1 flex flex-col space-y-4">

            <!-- Top Summary Bar with Big Numbers & Room Name -->
            <div class="bg-white rounded-2xl p-4 border-2 border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <label for="roomNameInput" class="text-sm font-bold text-slate-500 uppercase">Room Name:</label>
                    <input id="roomNameInput" type="text" value="Family Living Room" oninput="updateRoomName(this.value)" class="text-xl sm:text-2xl font-extrabold text-slate-900 bg-slate-100 border-2 border-slate-300 rounded-xl px-3.5 py-1.5 focus:border-blue-600 focus:outline-none w-60 sm:w-72">
                </div>

                <!-- Big Readable Room Measurements -->
                <div class="flex flex-wrap items-center gap-3 sm:gap-6">
                    <div class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-xl">
                        <div class="text-xs font-bold text-blue-700 uppercase">Total Floor Area</div>
                        <div id="bigSqFtDisplay" class="text-xl sm:text-2xl font-extrabold text-blue-950">342 sq ft</div>
                    </div>
                    <div class="bg-slate-100 border border-slate-200 px-4 py-2 rounded-xl">
                        <div class="text-xs font-bold text-slate-600 uppercase">Total Wall Length</div>
                        <div id="bigPerimeterDisplay" class="text-xl sm:text-2xl font-extrabold text-slate-900">76 ft 4 in</div>
                    </div>
                    <button onclick="goToStep(3)" class="touch-btn px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-base sm:text-lg shadow-md flex items-center gap-2">
                        <span>🖨️ Next: Print or Save →</span>
                    </button>
                </div>
            </div>

            <!-- Simple One-Tap Action Toolbar -->
            <div class="bg-white rounded-2xl p-3 border-2 border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2">
                    <button onclick="setSimpleTool('move')" id="easyTool-move" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-blue-600 text-white shadow flex items-center gap-2">
                        <span>👆 Move Corners</span>
                    </button>
                    <button onclick="setSimpleTool('door')" id="easyTool-door" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 flex items-center gap-2">
                        <span>🚪 + Add a Door</span>
                    </button>
                    <button onclick="setSimpleTool('window')" id="easyTool-window" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 flex items-center gap-2">
                        <span>🪟 + Add a Window</span>
                    </button>
                    <button onclick="setSimpleTool('split')" id="easyTool-split" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 flex items-center gap-2">
                        <span>➕ Add Wall Corner</span>
                    </button>
                    <button onclick="straightenAllWalls()" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border-2 border-emerald-300 flex items-center gap-2">
                        <span>📐 Straighten Walls</span>
                    </button>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="undoLastChange()" id="undoBtn" class="touch-btn px-4 py-2.5 rounded-xl font-bold text-base bg-amber-100 hover:bg-amber-200 text-amber-950 border border-amber-300 flex items-center gap-1.5">
                        <span>↩️ Undo</span>
                    </button>
                </div>
            </div>

            <!-- Plain-English Helper Instruction Banner + Exact Wall Length Editor -->
            <div class="bg-blue-950 text-white rounded-2xl px-5 py-3.5 flex flex-col lg:flex-row items-center justify-between gap-4 shadow">
                <div class="flex items-center gap-3 text-base sm:text-lg font-semibold">
                    <span class="text-2xl">💡</span>
                    <span id="helperInstructionBanner">Drag any blue circle with your finger to move a corner, or tap a wall to type its exact length.</span>
                </div>

                <!-- Selected Wall Length Quick Setter (Feet & Inches) -->
                <div class="flex flex-wrap items-center gap-2 bg-blue-900/90 px-4 py-2 rounded-xl border border-blue-400/30 shrink-0">
                    <span id="selectedWallTitle" class="font-bold text-sm text-cyan-300 mr-1">Selected Wall #1:</span>
                    <div class="flex items-center gap-1">
                        <input id="wallFeetInput" type="number" min="1" max="80" value="14" class="w-16 h-11 rounded-lg bg-white text-slate-900 font-extrabold text-lg text-center border-2 border-blue-400">
                        <span class="font-bold text-sm">ft</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <input id="wallInchesInput" type="number" min="0" max="11" value="0" class="w-16 h-11 rounded-lg bg-white text-slate-900 font-extrabold text-lg text-center border-2 border-blue-400">
                        <span class="font-bold text-sm">in</span>
                    </div>
                    <button onclick="applyFeetInchesWallLength()" class="h-11 px-4 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-extrabold text-sm shadow">
                        Set Length
                    </button>
                </div>
            </div>

            <!-- Side-by-Side 2D Floorplan & 3D Dollhouse View -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 min-h-[480px]">
                
                <!-- Left: 2D Floorplan Canvas (7 cols) -->
                <div class="lg:col-span-7 bg-white rounded-3xl border-2 border-slate-300 shadow-md flex flex-col overflow-hidden relative min-h-[420px]">
                    <div class="bg-slate-100 border-b border-slate-200 px-4 py-2.5 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-blue-600"></span>
                            <span class="font-extrabold text-base text-slate-800">2D Room Floorplan (Feet & Inches)</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button onclick="zoom2D(1.15)" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 font-extrabold text-slate-800 hover:bg-slate-50 text-base">🔍 +</button>
                            <button onclick="zoom2D(0.85)" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 font-extrabold text-slate-800 hover:bg-slate-50 text-base">🔍 −</button>
                            <button onclick="center2DView()" class="px-3 py-1.5 rounded-lg bg-white border border-slate-300 font-bold text-slate-700 hover:bg-slate-50 text-sm">Center</button>
                        </div>
                    </div>
                    <div class="flex-1 relative blueprint-grid">
                        <canvas id="canvas2D" class="w-full h-full cursor-pointer"></canvas>
                    </div>
                </div>

                <!-- Right: 3D Dollhouse Preview (5 cols) -->
                <div class="lg:col-span-5 bg-slate-900 rounded-3xl border-2 border-slate-300 shadow-md flex flex-col overflow-hidden relative min-h-[380px]">
                    <div class="bg-slate-800 border-b border-slate-700 px-4 py-2.5 flex items-center justify-between text-white">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                            <span class="font-extrabold text-base">3D Dollhouse View</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button onclick="set3DViewAngle('angled')" class="px-3 py-1 rounded-lg bg-blue-600 text-white font-bold text-xs">3D Tilt</button>
                            <button onclick="set3DViewAngle('top')" class="px-3 py-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold text-xs">Top View</button>
                        </div>
                    </div>
                    <div id="threeViewport" class="flex-1 w-full h-full relative"></div>
                    <div class="bg-slate-950/90 text-slate-300 text-sm font-medium px-4 py-2 text-center">
                        👆 Drag with 1 finger to spin your 3D room around
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== STEP 3: PRINT & SAVE CONTRACTOR SHEET ==================== -->
        <section id="step3Section" class="hidden space-y-6 py-2">
            
            <!-- Top Action Buttons (Hidden when printing) -->
            <div class="no-print bg-white rounded-3xl p-6 border-2 border-slate-200 shadow-md flex flex-col lg:flex-row items-center justify-between gap-4">
                <div>
                    <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs uppercase mb-1">Step 3 of 3 • Ready to Share</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Your Floorplan Sheet is Ready!</h2>
                    <p class="text-base text-slate-600">Print this page or save a picture to hand to your flooring installer, contractor, or furniture store.</p>
                </div>

                <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                    <button onclick="window.print()" class="touch-btn flex-1 lg:flex-initial px-6 py-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-lg shadow-lg flex items-center justify-center gap-2">
                        <span>🖨️ Print / Save as PDF</span>
                    </button>
                    <button onclick="downloadFloorplanImage()" class="touch-btn flex-1 lg:flex-initial px-6 py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-lg shadow-lg flex items-center justify-center gap-2">
                        <span>🖼️ Save Picture (PNG)</span>
                    </button>
                    <button onclick="downloadContractorDXF()" class="touch-btn flex-1 lg:flex-initial px-5 py-4 rounded-2xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-base shadow flex items-center justify-center gap-2">
                        <span>📐 Contractor CAD (.DXF)</span>
                    </button>
                </div>
            </div>

            <!-- Printable Architectural Sheet -->
            <div id="printSheetContainer" class="bg-white rounded-3xl p-6 sm:p-10 border-2 border-slate-300 shadow-xl max-w-5xl mx-auto space-y-6">
                
                <!-- Sheet Header / Title Block -->
                <div class="border-b-4 border-slate-900 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                    <div>
                        <div class="text-xs font-extrabold uppercase tracking-widest text-slate-500">Measured Room Floorplan</div>
                        <h3 id="printRoomTitle" class="text-3xl font-extrabold text-slate-900 mt-1">Family Living Room</h3>
                    </div>
                    <div class="text-left sm:text-right text-sm font-semibold text-slate-600 space-y-0.5">
                        <div>Date Prepared: <span id="printDateStamp" class="font-bold text-slate-900"></span></div>
                        <div>Ceiling Height: <span id="printCeilingLabel" class="font-bold text-slate-900">9 ft 0 in</span></div>
                    </div>
                </div>

                <!-- Key Summary Boxes for Contractor / Flooring Store -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="p-4 rounded-2xl bg-slate-50 border-2 border-slate-200">
                        <div class="text-xs font-bold uppercase text-slate-500">Total Floor Area</div>
                        <div id="printSqFt" class="text-2xl font-extrabold text-blue-700 mt-1">342 sq ft</div>
                        <div id="printSqFtPlusWaste" class="text-xs font-semibold text-slate-500 mt-0.5">+10% flooring: 376 sq ft</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border-2 border-slate-200">
                        <div class="text-xs font-bold uppercase text-slate-500">Total Baseboard / Perimeter</div>
                        <div id="printPerimeter" class="text-2xl font-extrabold text-slate-900 mt-1">76 ft 4 in</div>
                        <div class="text-xs font-semibold text-slate-500 mt-0.5">All walls combined</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border-2 border-slate-200">
                        <div class="text-xs font-bold uppercase text-slate-500">Number of Walls</div>
                        <div id="printWallCount" class="text-2xl font-extrabold text-slate-900 mt-1">6 Walls</div>
                        <div class="text-xs font-semibold text-slate-500 mt-0.5">Measured corner-to-corner</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border-2 border-slate-200">
                        <div class="text-xs font-bold uppercase text-slate-500">Doors & Windows</div>
                        <div id="printOpenings" class="text-2xl font-extrabold text-slate-900 mt-1">2 Doors, 3 Win</div>
                        <div class="text-xs font-semibold text-slate-500 mt-0.5">Marked on drawing</div>
                    </div>
                </div>

                <!-- High-Resolution Printable Floorplan Drawing -->
                <div class="border-2 border-slate-300 rounded-2xl overflow-hidden bg-white p-2">
                    <canvas id="printSnapshotCanvas" width="900" height="520" class="w-full h-auto block mx-auto"></canvas>
                </div>

