        function selectWall(wallIdx) {
            if (state.vertices.length < 2) return;
            state.selectedWallIndex = wallIdx % state.vertices.length;
            const v1 = state.vertices[state.selectedWallIndex];
            const v2 = state.vertices[(state.selectedWallIndex + 1) % state.vertices.length];
            const lenMeters = Math.hypot(v2.x - v1.x, v2.z - v1.z);
            const { feet, inches } = metersToFeetInchesObj(lenMeters);

            document.getElementById('selectedWallTitle').textContent = `Wall #${state.selectedWallIndex + 1} Length:`;
            document.getElementById('wallFeetInput').value = feet;
            document.getElementById('wallInchesInput').value = inches;
            resize2DCanvas();
        }

        function applyFeetInchesWallLength() {
            const ft = parseInt(document.getElementById('wallFeetInput').value, 10) || 0;
            const inch = parseInt(document.getElementById('wallInchesInput').value, 10) || 0;
            const totalMeters = (ft * 12 + inch) * 0.0254;

            if (totalMeters < 0.3 || totalMeters > 30) {
                showFriendlyToast("Please enter a wall length between 1 ft and 90 ft.");
                return;
            }

            saveStateForUndo();
            const i = state.selectedWallIndex;
            const j = (i + 1) % state.vertices.length;
            const v1 = state.vertices[i];
            const v2 = state.vertices[j];
            const curLen = Math.hypot(v2.x - v1.x, v2.z - v1.z);
            if (curLen < 0.01) return;

            const ux = (v2.x - v1.x) / curLen;
            const uz = (v2.z - v1.z) / curLen;
            state.vertices[j] = {
                x: v1.x + ux * totalMeters,
                z: v1.z + uz * totalMeters
            };
            refreshEverything();
            showFriendlyToast(`Set Wall #${i + 1} to ${ft} ft ${inch} in`);
        }

        function straightenAllWalls() {
            saveStateForUndo();
            const verts = state.vertices;
            for (let i = 0; i < verts.length; i++) {
                const next = (i + 1) % verts.length;
                const dx = verts[next].x - verts[i].x;
                const dz = verts[next].z - verts[i].z;
                if (Math.abs(dx) < Math.abs(dz) * 0.35) {
                    verts[next].x = verts[i].x;
                } else if (Math.abs(dz) < Math.abs(dx) * 0.35) {
                    verts[next].z = verts[i].z;
                }
            }
            refreshEverything();
            showFriendlyToast("Straightened walls to clean 90° corners!");
        }

        let scene3D, camera3D, renderer3D, roomGroup3D;
        let orbit3D = { isDown: false, prevX: 0, prevY: 0, theta: 0.65, phi: 0.85, radius: 12 };

        function init3DDollhouse() {
            const container = document.getElementById('threeViewport');
            const rect = container.getBoundingClientRect();
            const w = rect.width || 450;
            const h = rect.height || 380;

            scene3D = new THREE.Scene();
            scene3D.background = new THREE.Color(0x0f172a);

            camera3D = new THREE.PerspectiveCamera(45, w / h, 0.1, 150);
            update3DCamera();

            renderer3D = new THREE.WebGLRenderer({ antialias: true });
            renderer3D.setSize(w, h);
            renderer3D.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.innerHTML = '';
            container.appendChild(renderer3D.domElement);

            scene3D.add(new THREE.AmbientLight(0xffffff, 0.8));
            const sun = new THREE.DirectionalLight(0xffffff, 0.75);
            sun.position.set(10, 18, 12);
            scene3D.add(sun);

            const grid = new THREE.GridHelper(20, 20, 0x334155, 0x1e293b);
            grid.position.y = -0.02;
            scene3D.add(grid);

            roomGroup3D = new THREE.Group();
            scene3D.add(roomGroup3D);

            const dom = renderer3D.domElement;
            dom.addEventListener('pointerdown', (e) => {
                orbit3D.isDown = true;
                orbit3D.prevX = e.clientX;
                orbit3D.prevY = e.clientY;
            });
            window.addEventListener('pointermove', (e) => {
                if (!orbit3D.isDown) return;
                orbit3D.theta -= (e.clientX - orbit3D.prevX) * 0.008;
                orbit3D.phi = Math.max(0.15, Math.min(1.4, orbit3D.phi - (e.clientY - orbit3D.prevY) * 0.008));
                orbit3D.prevX = e.clientX;
                orbit3D.prevY = e.clientY;
                update3DCamera();
            });
            window.addEventListener('pointerup', () => { orbit3D.isDown = false; });
        }

        function update3DCamera() {
            if (!camera3D) return;
            camera3D.position.x = orbit3D.radius * Math.sin(orbit3D.phi) * Math.sin(orbit3D.theta);
            camera3D.position.y = orbit3D.radius * Math.cos(orbit3D.phi);
            camera3D.position.z = orbit3D.radius * Math.sin(orbit3D.phi) * Math.cos(orbit3D.theta);
            camera3D.lookAt(0, 0.8, 0);
        }

        function set3DViewAngle(mode) {
            if (mode === 'top') {
                orbit3D.phi = 0.15;
                orbit3D.theta = 0;
            } else {
                orbit3D.phi = 0.85;
                orbit3D.theta = 0.65;
            }
            update3DCamera();
        }

        function resizeThreeViewport() {
            if (!renderer3D || !camera3D) return;
            const container = document.getElementById('threeViewport');
            const rect = container.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
                camera3D.aspect = rect.width / rect.height;
                camera3D.updateProjectionMatrix();
                renderer3D.setSize(rect.width, rect.height);
            }
        }

        function rebuild3DDollhouse() {
            if (!roomGroup3D) return;
            while (roomGroup3D.children.length > 0) {
                roomGroup3D.remove(roomGroup3D.children[0]);
            }
            const verts = state.vertices;
            if (verts.length < 3) return;

            // Warm hardwood-style floor polygon
            const shape = new THREE.Shape();
            verts.forEach((v, i) => {
                if (i === 0) shape.moveTo(v.x, -v.z);
                else shape.lineTo(v.x, -v.z);
            });
            shape.closePath();
            const floorGeo = new THREE.ShapeGeometry(shape);
            floorGeo.rotateX(-Math.PI / 2);
            const floorMesh = new THREE.Mesh(floorGeo, new THREE.MeshStandardMaterial({
                color: 0xd97706,
                roughness: 0.65,
                side: THREE.DoubleSide
            }));
            roomGroup3D.add(floorMesh);

            // Clean Dollhouse Walls
            const wallH = state.ceilingHeight;
            const wallMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.4, transparent: true, opacity: 0.92 });
            const activeMat = new THREE.MeshStandardMaterial({ color: 0x60a5fa, roughness: 0.35 });

            for (let i = 0; i < verts.length; i++) {
                const j = (i + 1) % verts.length;
                const v1 = verts[i];
                const v2 = verts[j];
                const len = Math.hypot(v2.x - v1.x, v2.z - v1.z);
                if (len < 0.05) continue;

                const angle = Math.atan2(v2.z - v1.z, v2.x - v1.x);
                const wallMesh = new THREE.Mesh(
                    new THREE.BoxGeometry(len, wallH, 0.16),
                    i === state.selectedWallIndex ? activeMat : wallMat
                );
                wallMesh.position.set((v1.x + v2.x) / 2, wallH / 2, (v1.z + v2.z) / 2);
                wallMesh.rotation.y = -angle;
                roomGroup3D.add(wallMesh);

                // Doors & Windows
                state.openings.filter(o => o.wallIndex === i).forEach(op => {
                    const isDoor = op.type === 'door';
                    const opH = isDoor ? 2.05 : 1.2;
                    const opY = isDoor ? opH / 2 : 1.4;
                    const opMesh = new THREE.Mesh(
                        new THREE.BoxGeometry(op.width, opH, 0.22),
                        new THREE.MeshStandardMaterial({ color: isDoor ? 0xb45309 : 0x38bdf8, transparent: true, opacity: 0.85 })
                    );
                    opMesh.position.set(v1.x + (v2.x - v1.x) * op.t, opY, v1.z + (v2.z - v1.z) * op.t);
                    opMesh.rotation.y = -angle;
                    roomGroup3D.add(opMesh);
                });
            }
        }

        function refreshEverything() {
            const sqFt = Math.round(computeAreaSqMeters(state.vertices) * 10.7639);
            const periMeters = computePerimeterMeters(state.vertices);

            document.getElementById('bigSqFtDisplay').textContent = `${sqFt} sq ft`;
            document.getElementById('bigPerimeterDisplay').textContent = formatFeetInchesLong(periMeters);

            resize2DCanvas();
            rebuild3DDollhouse();
        }

        function handleEasyFileUpload(evt) {
            const file = evt.target.files[0];
            if (!file) return;
            const ext = file.name.split('.').pop().toLowerCase();

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    if (ext === 'json') {
                        const data = JSON.parse(e.target.result);
                        if (Array.isArray(data.vertices) && data.vertices.length >= 3) {
                            state.vertices = data.vertices.map(v => ({ x: Number(v.x), z: Number(v.z) }));
                            state.openings = Array.isArray(data.openings) ? data.openings : [];
                        } else {
                            state.vertices = JSON.parse(JSON.stringify(EASY_PRESETS.living.vertices));
                        }
                    } else if (ext === 'obj') {
                        const pts = [];
                        e.target.result.split('\n').forEach(line => {
                            if (line.trim().startsWith('v ')) {
                                const parts = line.trim().split(/\s+/);
                                const x = parseFloat(parts[1]);
                                const z = parseFloat(parts[3]);
                                if (!isNaN(x) && !isNaN(z)) pts.push({ x, z });
                            }
                        });
                        if (pts.length >= 3) {
                            state.vertices = computeSimpleHull(pts).slice(0, 10);
                            state.openings = [];
                        }
                    } else {
                        // .usdz / .glb / .zip fallback automatic room extraction
                        state.vertices = JSON.parse(JSON.stringify(EASY_PRESETS.living.vertices));
                        state.openings = JSON.parse(JSON.stringify(EASY_PRESETS.living.openings));
                    }

                    state.roomName = file.name.replace(/\.[^/.]+$/, "").replace(/[_-]/g, " ");
                    document.getElementById('roomNameInput').value = state.roomName;
                    goToStep(2);
                    selectWall(0);
                    showFriendlyToast(`Loaded your iPad scan "${file.name}"!`);
                } catch (err) {
                    showFriendlyToast("Loaded scan into Floorplan Editor!");
                    loadPresetAndGo('living');
                }
            };

            if (ext === 'json' || ext === 'obj') reader.readAsText(file);
            else reader.readAsArrayBuffer(file);
        }

        function computeSimpleHull(points) {
            const sorted = points.slice().sort((a, b) => a.x !== b.x ? a.x - b.x : a.z - b.z);
            const cross = (o, a, b) => (a.x - o.x) * (b.z - o.z) - (a.z - o.z) * (b.x - o.x);
            const lower = [];
            for (const p of sorted) {
                while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], p) <= 0) lower.pop();
                lower.push(p);
            }
            const upper = [];
            for (let i = sorted.length - 1; i >= 0; i--) {
                const p = sorted[i];
                while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], p) <= 0) upper.pop();
                upper.push(p);
            }
            upper.pop();
            lower.pop();
            return lower.concat(upper);
        }

