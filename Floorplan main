        function updateEasyCameraAim() {
            const yaw = parseFloat(document.getElementById('easyYawSlider').value) || 40;
            const pitch = parseFloat(document.getElementById('easyPitchSlider').value) || 28;
            state.cameraMeasurer.yaw = yaw;
            state.cameraMeasurer.pitch = pitch;

            const pitchRad = (pitch * Math.PI) / 180;
            const yawRad = (yaw * Math.PI) / 180;
            const dist = Math.min(7.5, Math.max(0.8, state.cameraMeasurer.heightMeters / Math.tan(pitchRad)));
            const hx = Math.sin(yawRad) * dist;
            const hz = -Math.cos(yawRad) * dist;

            state.cameraMeasurer.currentHit = { x: hx, z: hz, distMeters: dist };
            document.getElementById('cameraDistanceReadout').textContent = `${formatFeetInchesLong(dist)} away`;
            document.getElementById('markedCornersBadge').textContent = `${state.cameraMeasurer.points.length} Corners Marked`;

            drawMiniCornerPreview();
        }

        function markFloorCorner() {
