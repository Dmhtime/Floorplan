        function onEasyDeviceOrientation(e) {
            if (e.beta !== null) {
                state.cameraMeasurer.pitch = Math.max(15, Math.min(60, 90 - e.beta));
                state.cameraMeasurer.yaw = (e.alpha || 0) % 360;
                document.getElementById('easyPitchSlider').value = state.cameraMeasurer.pitch;
                document.getElementById('easyYawSlider').value = state.cameraMeasurer.yaw;
                updateEasyCameraAim();
            }
